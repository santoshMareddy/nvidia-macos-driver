#version 450
// saxpy: y[i] = a * x[i] + y[i]. The probe's one kernel: enough to prove dispatch, memory and results.
layout(local_size_x = 256) in;
layout(push_constant) uniform Params { float a; uint n; } params;
layout(std430, set = 0, binding = 0) readonly buffer X { float x[]; };
layout(std430, set = 0, binding = 1) buffer Y { float y[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= params.n) return;
    y[i] = params.a * x[i] + y[i];
}
